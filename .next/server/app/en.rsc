e:["$","$L18",null,{"formats":"$undefined","locale":"en","messages":{"meta":{"siteName":"bigblakboks","titleSuffix":"bigblakboks — systems engineering lab","description":"bigblakboks is a two-person studio that doesn't design websites. We design systems."},"nav":{"home":"home","products":"products","about":"about us","contact":"contact","menu":"menu","close":"close"},"langSwitch":{"fa":"fa","en":"EN"},"footerLabel":"engineering lab — bigblakboks","social":{"instagram":"instagram","linkedin":"linkedin","github":"github","telegram":"telegram"},"home":{"eyebrow":"bigblakboks / systems engineering lab","kicker":"01 / home","headlineLine1":"we don't design","headlineLine2":"websites.","headlineLine3":"we design systems.","lead":"two of us. thinking like a full technical team — from the interface you see to the engine running quietly behind it, making everyone's job easier.","blocks":[{"label":"team","value":"2 engineers, one mind"},{"label":"approach","value":"systems, not just screens"},{"label":"output","value":"websites, web apps, automation"},{"label":"based","value":"remote, always reachable"}],"statement":"every project that reaches us gets treated as an engineered black box — simple and clear on the outside, precise and flawless within.","ctaLabel":"let's build your system","ctaHint":"start a project"},"products":{"eyebrow":"bigblakboks / service catalog","kicker":"02 / products","headline":"what we build","lead":"every service is a module of the same system — pick one, or let us wire the whole thing together for you.","items":[{"index":"001","title":"websites & web apps","description":"design and development of sites and web applications, built for speed, identity, and a flawless user experience."},{"index":"002","title":"internal business systems","description":"admin panels, custom workflows, and tools that make your team's daily work simpler and more transparent."},{"index":"003","title":"automation & integration","description":"connecting your services, tools, and data — what used to be manual now runs on its own."},{"index":"004","title":"product & saas design","description":"from idea to shippable v1 — product architecture, interface, and an experience people actually enjoy using."},{"index":"005","title":"dashboards & data analytics","description":"we turn scattered data into clear decisions — dashboards that actually get read."}],"ctaLabel":"bring us your project","ctaHint":"request a consult"},"about":{"eyebrow":"bigblakboks / the team","kicker":"03 / about us","headline":"two people, one system of thought","lead":"bigblakboks was built by two people who see interface design and backend architecture as one continuous thing. we believe the best products come from a coherent system of thought, not scattered individual work.","blocks":[{"label":"founded as","value":"independent 2-person team"},{"label":"philosophy","value":"system before screen"},{"label":"scope","value":"design through deployment"},{"label":"collaboration","value":"transparent, step by step"}],"processTitle":"how we work","process":[{"step":"01","title":"understand","description":"before any design or code, we find where the real problem lives."},{"step":"02","title":"design the system","description":"we map the full architecture — interface, data flow, and everything between."},{"step":"03","title":"build & test","description":"we build in stages, show progress, and refine with your feedback."},{"step":"04","title":"ship & support","description":"we deliver the system and stay close as it grows."}],"statement":"we named it bigblakboks because our job is to keep the complexity inside the box, and hand you only the simplicity.","ctaLabel":"get to know us","ctaHint":"start a conversation"},"contact":{"title":"let's build it","subtitle":"send us a few lines — we reply within one business day.","nameLabel":"name","namePlaceholder":"your name","emailLabel":"email","emailPlaceholder":"you@example.com","messageLabel":"message","messagePlaceholder":"tell us 