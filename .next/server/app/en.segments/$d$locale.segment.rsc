0:{"buildId":"kCmWw1qxjMzXE-fIEmvth","data":[{"rsc":["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/42uuxw6m530f8.css","precedence":"next"}],["$","script","script-0",{"src":"/_next/static/chunks/3jwtpsl5iwlak.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/31fjbrf1l731f.js","async":true}]],["$","html",null,{"lang":"en","dir":"ltr","className":"familjen_grotesk_c2e981a5-module__nGLR7q__variable manrope_67fd1262-module__etJz-a__variable vazirmatn_3ed916ca-module__PkwkQq__variable jetbrains_mono_c204fc1d-module__jQLt9W__variable h-full","children":["$","body",null,{"className":"h-full bg-bg text-fg antialiased selection:bg-accent selection:text-bg","children":["$","$L2",null,{"locale":"en","messages":{"meta":{"siteName":"bigblakboks","titleSuffix":"bigblakboks — systems engineering lab","description":"bigblakboks is a two-person studio that doesn't design websites. We design systems."},"nav":{"home":"home","products":"products","portfolio":"portfolio","about":"about us","contact":"contact","menu":"menu","close":"close"},"langSwitch":{"fa":"fa","en":"EN"},"footerLabel":"engineering lab — bigblakboks","social":{"instagram":"instagram","linkedin":"linkedin","github":"github","telegram":"telegram"},"home":{"eyebrow":"bigblakboks / systems engineering lab","kicker":"01 / home","headlineLine1":"we don't design","headlineLine2":"websites.","headlineLine3":"we design systems.","lead":"two of us. thinking like a full technical team — from the interface you see to the engine running quietly behind it, making everyone's job easier.","blocks":[{"label":"team","value":"2 engineers, one mind"},{"label":"approach","value":"systems, not just screens"},{"label":"output","value":"websites, web apps, automation"},{"label":"based","value":"remote, always reachable"}],"statement":"every project that reaches us gets treated as an engineered black box — simple and clear on the outside, precise and flawless within.","ctaLabel":"let's build your system","ctaHint":"start a project"},"products":{"eyebrow":"bigblakboks / service catalog","kicker":"02 / products","headline":"what we build","lead":"every service is a module of the same system — pick one, or let us wire the whole thing together for you.","items":[{"index":"001","title":"websites & web apps","description":"design and development of sites and web applications, built for speed, identity, and a flawless user experience."},{"index":"002","title":"internal business systems","description":"admin panels, custom workflows, and tools that make your team's daily work simpler and more transparent."},{"index":"003","title":"automation & integration","description":"connecting your services, tools, and data — what used to be manual now runs on its own."},{"index":"004","title":"product & saas design","description":"from idea to shippable v1 — product architecture, interface, and an experience people actually enjoy using."},{"index":"005","title":"dashboards & data analytics","description":"we turn scattered data into clear decisions — dashboards that actually get read."}],"ctaLabel":"bring us your project","ctaHint":"request a consult"},"about":{"eyebrow":"bigblakboks / the team","kicker":"03 / about us","headline":"two people, one system of thought","lead":"bigblakboks was built by two people who see interface design and backend architecture as one continuous thing. we believe the best products come from a coherent system of thought, not scattered individual work.","blocks":[{"label":"founded as","value":"independent 2-person team"},{"label":"philosophy","value":"system before screen"},{"label":"scope","value":"design through deployment"},{"label":"collaboration","value":"transparent, step by step"}],"processTitle":"how we work","process":[{"step":"01","title":"understand","description":"before any design or code, we find where the real problem lives."},{"step":"02","title":"design the system","description":"we map the full architecture — interface, data flow, and everything between."},{"step":"03","title":"build & test","description":"we build in stages, show progress, and refine with your feedback."},{"step":"04","title":"ship & support","description":"we deliver the system and stay close as it grows."}],"statement":"we named it bigblakboks because our job is to keep the complexity inside the box, and hand you only the simplicity.","ctaLabel":"get to know us","ctaHint":"start a conversation"},"contact":{"title":"let's build it","subtitle":"send us a few lines — we reply within one business day.","nameLabel":"name","namePlaceholder":"your name","emailLabel":"email","emailPlaceholder":"you@example.com","messageLabel":"message","messagePlaceholder":"tell us about your project...","submit":"send message","sending":"sending...","success":"got it — we'll be in touch soon.","error":"something went wrong. try again or email us directly.","close":"close"},"portfolio":{"eyebrow":"bigblakboks / selected work","kicker":"04 / portfolio","headline":"projects we've built","lead":"a selection of systems, products, and digital experiences we've engineered from the ground up. each one a black box: complex inside, simple outside.","items":[{"id":"ecommerce-platform","index":"001","title":"E-Commerce Platform","shortDescription":"A full-stack e-commerce solution with custom inventory management.","fullDescription":"We engineered a high-performance e-commerce ecosystem designed for rapid scaling. By focusing on automation and user experience, we transformed a standard online shop into a revenue-generating machine that operates 24/7 without manual intervention.","challenge":"The client struggled with manual inventory updates, slow checkout processes causing 60% cart abandonment, and a legacy system that crashed during traffic spikes. They were losing sales every day.","solution":"We built a headless commerce architecture with Next.js for blazing-fast page loads, integrated automated inventory synchronization across warehouses, and redesigned the checkout flow to just 3 steps. Real-time analytics gave them instant visibility into sales performance.","results":["60% reduction in cart abandonment","3x faster page load speeds","40% increase in conversion rate within 3 months","Zero downtime during Black Friday traffic surge"],"technologies":["Next.js","Node.js","PostgreSQL","Stripe","Redis"],"category":"Web Application"},{"id":"healthcare-dashboard","index":"002","title":"Healthcare Management System","shortDescription":"Patient management platform connecting clinics, doctors, and pharmacies.","fullDescription":"A HIPAA-compliant healthcare ecosystem that streamlines patient care from appointment booking to prescription fulfillment. We built a secure bridge between medical professionals, patients, and pharmacies.","challenge":"Medical staff wasted 20+ hours weekly on manual data entry across disconnected systems. Patient records were scattered, appointment no-shows were high, and data security was a constant concern.","solution":"We developed a unified dashboard with automated appointment reminders, electronic health records with role-based access, and integrated e-prescription features. End-to-end encryption ensured complete HIPAA compliance.","results":["20 hours saved per week per clinic","Zero data breaches since launch","35% reduction in appointment no-shows","95% satisfaction rate among medical staff"],"technologies":["React","TypeScript","AWS","MongoDB","Socket.io"],"category":"Business System"},{"id":"fintech-analytics","index":"003","title":"Financial Analytics Dashboard","shortDescription":"Real-time financial data visualization for investment firms.","fullDescription":"A sophisticated financial intelligence platform that transforms complex market data into actionable insights. We created a command center for investment decisions with millisecond-level data updates.","challenge":"Investment analysts were juggling 5+ different tools to get a complete market view. Data latency was causing missed opportunities, and custom reporting took hours to generate manually.","solution":"We aggregated multiple financial APIs into a single real-time dashboard with customizable widgets, automated report generation, and predictive analytics powered by machine learning algorithms.","results":["Real-time data from 12+ global exchanges","80% reduction in report generation time","Identified $2M+ in previously missed investment opportunities","Adopted by 3 major investment firms"],"technologies":["Vue.js","Python","D3.js","GraphQL","TimescaleDB"],"category":"Dashboard & Analytics"},{"id":"restaurant-app","index":"004","title":"Restaurant Ordering App","shortDescription":"Mobile-first ordering system with kitchen display integration.","fullDescription":"A contactless dining experience that increased order efficiency by 40%. Diners scan a QR code, browse an interactive menu, order, and pay—all from their phone. Kitchen staff receive orders instantly on digital displays.","challenge":"The restaurant chain faced severe staff shortages, long wait times leading to customer complaints, and inconsistent order accuracy. Table turnover was too slow to maximize revenue.","solution":"We deployed a Progressive Web App accessible via QR codes, integrated directly with kitchen display systems and POS. Smart upselling algorithms increased average order value, while automated order routing reduced kitchen errors.","results":["40% increase in order efficiency","25% faster table turnover","15% rise in average order value through smart upselling","90% reduction in order errors"],"technologies":["React","PWA","Firebase","Stripe","WebSocket"],"category":"Mobile & Web App"},{"id":"logistics-automation","index":"005","title":"Logistics Automation Platform","shortDescription":"End-to-end logistics management with route optimization.","fullDescription":"An intelligent logistics command center that optimizes delivery routes in real-time, tracks fleet movements globally, and automates dispatch decisions. We turned chaos into coordinated precision.","challenge":"The logistics company had zero visibility into their fleet, manual route planning was inefficient, and customers complained about unpredictable delivery times. Operational costs were spiraling.","solution":"We built a GPS-enabled tracking system with AI-powered route optimization, automated dispatch based on driver availability and traffic conditions, and customer-facing tracking portals with accurate ETAs.","results":["25% reduction in operational costs","30% fewer late deliveries","Real-time tracking for 100% of shipments","40% decrease in customer support tickets"],"technologies":["Angular","Go","Google Maps API","Kafka","PostgreSQL"],"category":"Automation & Integration"},{"id":"saas-project-tool","index":"006","title":"SaaS Project Management Tool","shortDescription":"Collaborative platform with task automation and client portals.","fullDescription":"A modern project management solution built for creative agencies and tech teams. We combined task management, client collaboration, and automated workflows into one intuitive platform.","challenge":"Remote teams were drowning in tool fragmentation—Slack for chat, Trello for tasks, Google Drive for files. Context switching was killing productivity, and clients felt out of the loop.","solution":"We delivered an all-in-one workspace with Kanban boards, time tracking, client portals for transparent progress viewing, and workflow automation that handles repetitive tasks automatically.","results":["Adopted by 200+ companies globally","25% improvement in project delivery times","Client satisfaction scores up 45%","50% reduction in status meeting time"],"technologies":["Svelte","Node.js","GraphQL","Docker","AWS"],"category":"SaaS Product"}],"ctaText":"Have a project in mind? Let's discuss how we can build a system tailored to your needs.","ctaLabel":"start a conversation"}},"timeZone":"UTC","children":"$L3"}]}]}]]}],"isPartial":"$@4","staleTime":"$5","varyParams":null},{"rsc":"$L6","isPartial":"$@7","staleTime":"$5","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@8","rootVaryParams":null,"needsRuntimeRequest":"$@9"}
