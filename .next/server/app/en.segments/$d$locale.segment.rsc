0:{"buildId":"TC-xhldQZk9zc0gbqS4D9","data":[{"rsc":["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/39-k4_hizky0l.css","precedence":"next"}],["$","script","script-0",{"src":"/_next/static/chunks/3jwtpsl5iwlak.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/31fjbrf1l731f.js","async":true}]],["$","html",null,{"lang":"en","dir":"ltr","className":"familjen_grotesk_c2e981a5-module__nGLR7q__variable manrope_67fd1262-module__etJz-a__variable vazirmatn_3ed916ca-module__PkwkQq__variable jetbrains_mono_c204fc1d-module__jQLt9W__variable h-full","children":["$","body",null,{"className":"h-full bg-bg text-fg antialiased selection:bg-accent selection:text-bg","children":["$","$L2",null,{"locale":"en","messages":{"meta":{"siteName":"bigblakboks","titleSuffix":"bigblakboks — systems engineering lab","description":"bigblakboks is a two-person studio that doesn't design websites. We design systems."},"nav":{"home":"home","products":"products","portfolio":"portfolio","about":"about us","contact":"contact","menu":"menu","close":"close"},"langSwitch":{"fa":"fa","en":"EN"},"footerLabel":"engineering lab — bigblakboks","social":{"instagram":"instagram","linkedin":"linkedin","github":"github","telegram":"telegram"},"home":{"eyebrow":"bigblakboks / systems engineering lab","kicker":"01 / home","headlineLine1":"we don't design","headlineLine2":"websites.","headlineLine3":"we design systems.","lead":"two of us. thinking like a full technical team — from the interface you see to the engine running quietly behind it, making everyone's job easier.","blocks":[{"label":"team","value":"2 engineers, one mind"},{"label":"approach","value":"systems, not just screens"},{"label":"output","value":"websites, web apps, automation"},{"label":"based","value":"remote, always reachable"}],"statement":"every project that reaches us gets treated as an engineered black box — simple and clear on the outside, precise and flawless within.","ctaLabel":"let's build your system","ctaHint":"start a project"},"products":{"eyebrow":"bigblakboks / service catalog","kicker":"02 / products","headline":"what we build","lead":"every service is a module of the same system — pick one, or let us wire the whole thing together for you.","items":[{"index":"001","title":"websites & web apps","description":"design and development of sites and web applications, built for speed, identity, and a flawless user experience."},{"index":"002","title":"internal business systems","description":"admin panels, custom workflows, and tools that make your team's daily work simpler and more transparent."},{"index":"003","title":"automation & integration","description":"connecting your services, tools, and data — what used to be manual now runs on its own."},{"index":"004","title":"product & saas design","description":"from idea to shippable v1 — product architecture, interface, and an experience people actually enjoy using."},{"index":"005","title":"dashboards & data analytics","description":"we turn scattered data into clear decisions — dashboards that actually get read."}],"ctaLabel":"bring us your project","ctaHint":"request a consult"},"about":{"eyebrow":"bigblakboks / the team","kicker":"03 / about us","headline":"two people, one system of thought","lead":"bigblakboks was built by two people who see interface design and backend architecture as one continuous thing. we believe the best products come from a coherent system of thought, not scattered individual work.","blocks":[{"label":"founded as","value":"independent 2-person team"},{"label":"philosophy","value":"system before screen"},{"label":"scope","value":"design through deployment"},{"label":"collaboration","value":"transparent, step by step"}],"processTitle":"how we work","process":[{"step":"01","title":"understand","description":"before any design or code, we find where the real problem lives."},{"step":"02","title":"design the system","description":"we map the full architecture — interface, data flow, and everything between."},{"step":"03","title":"build & test","description":"we build in stages, show progress, and refine with your feedback."},{"step":"04","title":"ship & support","description":"we deliver the system and stay close as it grows."}],"statement":"we named it bigblakboks because our job is to keep the complexity inside the box, and hand you only the simplicity.","ctaLabel":"get to know us","ctaHint":"start a conversation"},"contact":{"title":"let's build it","subtitle":"send us a few lines — we reply within one business day.","nameLabel":"name","namePlaceholder":"your name","emailLabel":"email","emailPlaceholder":"you@example.com","messageLabel":"message","messagePlaceholder":"tell us about your project...","submit":"send message","sending":"sending...","success":"got it — we'll be in touch soon.","error":"something went wrong. try again or email us directly.","close":"close"},"portfolio":{"eyebrow":"bigblakboks / selected work","kicker":"04 / portfolio","headline":"projects we've built","lead":"a selection of systems, products, and digital experiences we've engineered from the ground up. each one a black box: complex inside, simple outside.","items":[{"index":"001","title":"E-Commerce Platform","description":"A full-stack e-commerce solution with custom inventory management, automated order processing, and real-time analytics dashboard. Built for scalability and speed.","category":"Web Application"},{"index":"002","title":"Healthcare Management System","description":"Patient management platform connecting clinics, doctors, and pharmacies. Features appointment scheduling, electronic health records, and prescription tracking.","category":"Business System"},{"index":"003","title":"Financial Analytics Dashboard","description":"Real-time financial data visualization tool for investment firms. Aggregates multiple data sources into actionable insights with customizable reports.","category":"Dashboard & Analytics"},{"index":"004","title":"Restaurant Ordering App","description":"Mobile-first ordering system with kitchen display integration, inventory tracking, and customer loyalty program. Increased order efficiency by 40%.","category":"Mobile & Web App"},{"index":"005","title":"Logistics Automation Platform","description":"End-to-end logistics management system with route optimization, fleet tracking, and automated dispatch. Reduced operational costs by 25%.","category":"Automation & Integration"},{"index":"006","title":"SaaS Project Management Tool","description":"Collaborative project management platform with task automation, team workflows, and client portals. Designed for creative agencies and tech teams.","category":"SaaS Product"}],"ctaText":"Have a project in mind? Let's discuss how we can build a system tailored to your needs.","ctaLabel":"start a conversation"}},"timeZone":"UTC","children":"$L3"}]}]}]]}],"isPartial":"$@4","staleTime":"$5","varyParams":null},{"rsc":"$L6","isPartial":"$@7","staleTime":"$5","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@8","rootVaryParams":null,"needsRuntimeRequest":"$@9"}
