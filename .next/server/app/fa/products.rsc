f:["$","$L16",null,{"formats":"$undefined","locale":"fa","messages":{"meta":{"siteName":"بیگ‌بلک‌باکس","titleSuffix":"بیگ‌بلک‌باکس — آزمایشگاه مهندسی سیستم","description":"بیگ‌بلک‌باکس یک استودیوی دو نفره برای طراحی و ساخت سیستم‌های دیجیتال است."},"nav":{"home":"خانه","products":"خدمات","portfolio":"نمونه‌کارها","about":"درباره ما","contact":"تماس","menu":"منو","close":"بستن"},"langSwitch":{"fa":"فا","en":"EN"},"footerLabel":"آزمایشگاه مهندسی سیستم — بیگ‌بلک‌باکس","social":{"instagram":"اینستاگرام","linkedin":"لینکدین","github":"گیت‌هاب","telegram":"تلگرام"},"home":{"eyebrow":"بیگ‌بلک‌باکس / آزمایشگاه مهندسی سیستم","kicker":"۰۱ / خانه","headlineLine1":"ما سایت طراحی","headlineLine2":"نمی‌کنیم.","headlineLine3":"معماری دیجیتال می‌سازیم.","lead":"دو نفر هستیم با عمق تخصص یک تیم کامل. از استراتژی محصول تا معماری فنی، از تجربه کاربری تا زیرساخت مقیاس‌پذیر — هر لایه را با دقت مهندسی می‌کنیم.","blocks":[{"label":"تیم","value":"۲ مهندس ارشد، یک دیدگاه واحد"},{"label":"تخصص","value":"معماری سیستم‌های پیچیده"},{"label":"خروجی","value":"پلتفرم‌های دیجیتال enterprise-grade"},{"label":"تعهد","value":"کیفیت کد، عملکرد، مقیاس‌پذیری"}],"statement":"هر پروژه یک سیستم مهندسی‌شده است: ظاهری شفاف و کاربرپسند، باطنی دقیق، بهینه و قابل اتکا.","ctaLabel":"مشاوره فنی بگیرید","ctaHint":"شروع همکاری"},"products":{"eyebrow":"بیگ‌بلک‌باکس / کاتالوگ خدمات تخصصی","kicker":"۰۲ / خدمات","headline":"چه چیزی می‌سازیم","lead":"هر خدمت یک ماژول از یک سیستم کامل است؛ با استانداردهای enterprise و تمرکز بر مقیاس‌پذیری، امنیت و عملکرد.","items":[{"index":"۰۰۱","title":"پلتفرم‌های وب و وب‌اپلیکیشن","description":"توسعه معماری‌های مدرن با Next.js و React؛ بهینه‌شده برای SEO، سرعت بارگذاری زیر ۳ ثانیه و تجربه کاربری بی‌نقص."},{"index":"۰۰۲","title":"سیستم‌های داخلی سازمانی","description":"طراحی پنل‌های مدیریتی، CRMها و گردش‌کارهای سفارشی با قابلیت یکپارچه‌سازی API و گزارش‌گیری بلادرنگ."},{"index":"۰۰۳","title":"اتوماسیون و یکپارچه‌سازی سرویس‌ها","description":"اتصال هوشمند ابزارها، پایگاه‌های داده و سرویس‌های ابری؛ حذف فرآیندهای دستی و کاهش خطای انسانی تا ۹۰٪."},{"index":"۰۰۴","title":"طراحی و توسعه محصول SaaS","description":"از ایده تا MVP و مقیاس‌گذاری: معماری چندمستاجره، زیرساخت ابری، و تجربه کاربری مبتنی بر تحقیقات بازار."},{"index":"۰۰۵","title":"داشبوردهای تحلیلی و هوش تجاری","description":"تصویرسازی داده‌های پیچیده با D3.js و Plotly؛ تحلیل بلادرنگ، پیش‌بینی روندها و گزارش‌های اجرایی برای تصمیم‌گیری سریع."}],"ctaLabel":"درخواست مشاوره فنی","ctaHint":"بررسی نیازهای پروژه"},"about":{"eyebrow":"بیگ‌بلک‌باکس / درباره ما","kicker":"۰۳ / تیم","headline":"دو مهندس ارشد، یک دیدگاه استراتژیک","lead":"بیگ‌بلک‌باکس توسط دو مهندس با سابقه تأسیس شده که طراحی محصول و معماری سیستم را به‌عنوان یک کل واحد می‌بینند. ما معتقدیم محصولات دیجیتال موفق از تفکر سیستماتیک و عمیق ناشی می‌شوند، نه اجرای سطحی و پراکنده.","blocks":[{"label":"سابقه","value":"تأسیس توسط مهندسان ارشد"},{"label":"فلسفه","value":"معماری قبل از اجرا"},{"label":"دامنه تخصص","value":"از استراتژی تا استقرار production"},{"label":"روش همکاری","value":"شفافیت کامل، گزارش‌دهی مرحله‌ای"}],"processTitle":"متدولوژی کار ما","process":[{"step":"۰۱","title":"تحلیل عمیق مسئله","description":"قبل از هر تصمیم فنی، مسئله کسب‌وکار را ریشه‌یابی می‌کنیم و معیارهای موفقیت را تعریف می‌نماییم."},{"step":"۰۲","title":"طراحی معماری سیستم","description":"نقشه کامل: ساختار داده‌ها، جریان‌های کاربری، انتخاب تکنولوژی و استراتژی مقیاس‌پذیری."},{"step":"۰۳","title":"توسعه چابک با بازخورد مستمر","description":"تحویل نسخه‌های قابل تست در بازه‌های کوتاه، جمع‌آوری بازخورد و اصلاح مسیر بر اساس داده."},{"step":"۰۴","title":"استقرار و پشتیبانی بلندمدت","description":"راه‌اندازی روی زیرساخت ابری، مانیتورینگ عملکرد، و همراهی برای رشد و توسعه آینده."}],"statement":"نام بیگ‌بلک‌باکس را انتخاب کردیم چون وظیفه ما این است: پیچیدگی فنی را در لایه‌های زیرین مدیریت کنیم و خروجی ساده، قابل اتکا و مقیاس‌پذیر به شما تحویل دهیم.","ctaLabel":"گفتگوی تخصصی","ctaHint":"مشاوره رایگان"},"contact":{"title":"شروع همکاری","subtitle":"جزئیات پروژه خود را با ما در میان بگذارید. تیم فنی ما ظرف ۲۴ ساعت کاری پاسخ می‌دهد و جلسه مشاوره رایگان تنظیم می‌کند.","nameLabel":"نام کامل","namePlaceholder":"نام و نام خانوادگی","emailLabel":"ایمیل سازمانی","emailPlaceholder":"name@company.com","messageLabel":"شرح پروژه","messagePlaceholder":"اهداف کسب‌وکار، نیازمندی‌های فنی، زمان‌بندی مورد انتظار...","submit":"ارسال درخواست","sending":"در حال پردازش...","success":"درخواست شما ثبت شد. کارشناس فنی ما به‌زودی با شما تماس خواهد گرفت.","error":"خطایی رخ داد. لطفاً دوباره تلاش کنید یا مستقیماً ایمیل بزنید.","close":"انصراف"},"portfolio":{"eyebrow":"بیگ‌بلک‌باکس / نمونه‌کارهای منتخب","kicker":"۰۴ / پروژه‌ها","headline":"سیستم‌هایی که مهندسی کردیم","lead":"گزیده‌ای از پلتفرم‌ها، محصولات SaaS و سیستم‌های سازمانی که از صفر طراحی و پیاده‌سازی شده‌اند. هر پروژه با تمرکز بر مقیاس‌پذیری، امنیت و تجربه کاربری بهینه ساخته شده است.","items":[{"id":"ecommerce-platform","index":"۰۰۱","title":"پلتفرم فروشگاهی سازمانی","shortDescription":"راهکار جامع تجارت الکترونیک با مدیریت موجودی بلادرنگ و پردازش خودکار سفارشات.","fullDescription":"یک اکوسیستم فروشگاهی enterprise-grade طراحی کردیم که برای مقیاس‌پذیری بالا بهینه شده است. با تمرکز بر اتوماسیون کامل و تجربه کاربری بی‌نقص، یک فروشگاه آنلاین معمولی را به موتور درآمدزایی ۲۴/۷ تبدیل کردیم که بدون دخالت دستی عمل می‌کند.","challenge":"مشتری با بروزرسانی دستی موجودی، فرآیند پرداخت کند (۶۰٪ رها کردن سبد خرید)، و سیستم قدیمی که در ترافیک بالا crash می‌کرد مواجه بود. روزانه هزاران دلار فروش از دست می‌رفت.","solution":"معماری headless commerce با Next.js برای سرعت بارگذاری زیر ۲ ثانیه، همگام‌سازی خودکار موجودی بین ۵ انبار، و فرآیند پرداخت ۳ مرحله‌ای. داشبورد تحلیل بلادرنگ دید کامل به عملکرد فروش داد.","results":["کاهش ۶۰٪ رها کردن سبد خرید","سرعت بارگذاری ۳ برابر سریع‌تر (زیر ۲ ثانیه)","افزایش ۴۰٪ نرخ تبدیل در ۳ ماه اول","پردازش ۱۰,۰۰۰+ سفارش در بلک فرایدی بدون قطعی"],"technologies":["Next.js 14","Node.js","PostgreSQL","Stripe","Redis Cluster"],"category":"پلتفرم تجارت الکترونیک"},{"id":"healthcare-dashboard","index":"۰۰۲","title":"سیستم مدیریت مراکز درمانی","shortDescription":"پلتفرم یکپارچه مدیریت بیماران که کلینیک‌ها، پزشکان و داروخانه‌ها را متصل می‌کند.","fullDescription":"یک اکوسیستم مراقبت بهداشتی HIPAA-compliant که全流程 مراقبت بیمار از نوبت‌دهی تا تحویل نسخه را دیجیتال می‌کند. پل امن بین متخصصان پزشکی، بیماران و داروخانه‌ها با رمزنگاری end-to-end.","challenge":"کادر درمان ۲۰+ ساعت در هفته صرف ورود دستی داده در سیستم‌های جزیره‌ای می‌کردند. پرونده بیماران پراکنده، نرخ عدم حضور ۳۵٪، و نگرانی‌های جدی امنیت داده.","solution":"داشبورد یکپارچه با یادآورهای خودکار SMS/Email، پرونده الکترونیک سلامت با دسترسی مبتنی بر نقش (RBAC)، و نسخه الکترونیکی یکپارچه. ممیزی امنیتی کامل برای انطباق HIPAA.","results":["ذخیره ۲۰ ساعت زمان هفتگی per کلینیک","صفر نقض داده از زمان راه‌اندازی (۱۸+ ماه)","کاهش ۳۵٪ عدم حضور در نوبت‌ها","رضایت ۹۵٪ کادر پزشکی و اداری"],"technologies":["React 18","TypeScript","AWS HIPAA","MongoDB Atlas","Socket.io"],"category":"سیستم سلامت دیجیتال"},{"id":"fintech-analytics","index":"۰۰۳","title":"پلتفرم هوش مالی و تحلیل بازار","shortDescription":"داشبورد بلادرنگ تصویرسازی داده‌های مالی برای شرکت‌های سرمایه‌گذاری.","fullDescription":"یک پلتفرم financial intelligence پیشرفته که داده‌های پیچیده بازارهای جهانی را به بینش‌های عملی تبدیل می‌کند. مرکز فرماندهی برای تصمیمات سرمایه‌گذاری با بروزرسانی داده در سطح میلی‌ثانیه.","challenge":"تحلیلگران از ۵+ ابزار مجزا استفاده می‌کردند. تاخیر داده باعث از دست رفتن فرصت‌ها می‌شد، گزارش‌گیری سفارشی ساعت‌ها زمان می‌برد، و دید یکپارچه وجود نداشت.","solution":"تجمیع ۱۲+ API مالی جهانی در یک داشبورد واحد با ویجت‌های قابل تنظیم، تولید خودکار گزارش‌های PDF/Excel، و ماژول predictive analytics با الگوریتم‌های ML برای پیش‌بینی روندها.","results":["داده بلادرنگ از ۱۲ بورس جهانی (NYSE, NASDAQ, LSE, etc.)","کاهش ۸۰٪ زمان تهیه گزارش (از ۵ ساعت به ۳۰ دقیقه)","شناسایی ۲+ میلیون دلار فرصت سرمایه‌گذاری کشف‌شده","استفاده توسط ۳ شرکت سرمایه‌گذاری با AUM مجموع ۵۰۰+ میلیون دلار"],"technologies":["Vue.js 3","Python FastAPI","D3.js","GraphQL","TimescaleDB"],"category":"فناوری مالی (FinTech)"},{"id":"restaurant-app","index":"۰۰۴","title":"سیستم سفارش‌گیری هوشمند رستوران","shortDescription":"تجربه dining بدون تماس با یکپارچه‌سازی KDS و POS.","fullDescription":"یک Progressive Web App که فرآیند سفارش‌گیری را متحول کرد. مشتریان با اسکن QR کد منوی تعاملی را مرور کرده، سفارش داده و پرداخت می‌کنند. سفارشات مستقیماً به نمایشگرهای آشپزخانه ارسال می‌شوند.","challenge":"زنجیره رستوران با کمبود نیرو، زمان انتظار طولانی (شکایت مشتریان)، و خطاهای مکرر سفارش مواجه بود. چرخش میز کند و درآمد بهینه نبود.","solution":"PWA با دسترسی آسان via QR، یکپارچه‌سازی مستقیم با سیستم‌های KDS و POS موجود. الگوریتم‌های smart upselling بر اساس تاریخچه سفارشات، مسیریابی خودکار سفارش به ایستگاه‌های آشپزخانه.","results":["افزایش ۴۰٪ کارایی سفارش‌گیری","چرخش ۲۵٪ سریع‌تر میز (درآمد بیشتر per شیفت)","افزایش ۱۵٪ ارزش متوسط سفارش via upselling هوشمند","کاهش ۹۰٪ خطاهای سفارش (از ۱۲٪ به ۱.۲٪)"],"technologies":["React","PWA","Firebase","Stripe Terminal","WebSocket"],"category":"فناوری مهمان‌نوازی"},{"id":"logistics-automation","index":"۰۰۵","title":"پلتفرم مدیریت لجستیک و ناوگان","shortDescription":"سیستم端到端 ردیابی، بهینه‌سازی مسیر و اعزام هوشمند.","fullDescription":"مرکز فرماندهی لجستیک هوشمند که مسیرهای تحویل را بلادرنگ بهینه می‌کند، حرکات ناوگان را در سطح جهانی ردیابی می‌کند، و تصمیمات اعزام را خودکار می‌نماید. تبدیل هرج‌ومرج به هماهنگی دقیق.","challenge":"شرکت لجستیک دید صفر به ناوگان ۲۰۰+ خودرویی خود داشت. برنامه‌ریزی دستی مسیر ناکارآمد بود، ETAها غیرقابل پیش‌بینی، و هزینه‌های عملیاتی سرسام‌آور.","solution":"سیستم GPS-enabled با الگوریتم بهینه‌سازی مسیر AI-powered (کاهش ۲۵٪ مسافت طی‌شده)، اعزام خودکار بر اساس دسترسی راننده و ترافیک بلادرنگ، پورتال ردیابی مشتری با ETA دقیق.","results":["کاهش ۲۵٪ هزینه‌های عملیاتی (سوخت، استهلاک)","۳۰٪ کاهش تحویل‌های دیرکرددار","ردیابی بلادرنگ ۱۰۰٪ محموله‌ها","کاهش ۴۰٪ تیکت‌های پشتیبانی مشتری"],"technologies":["Angular","Go","Google Maps Platform","Apache Kafka","PostgreSQL/PostGIS"],"category":"لجستیک و زنجیره تأمین"},{"id":"saas-project-tool","index":"۰۰۶","title":"پلتفرم مدیریت پروژه SaaS","shortDescription":"فضای کار collaborative با اتوماسیون گردش کار و پورتال مشتریان.","fullDescription":"راهکار modern project management برای آژانس‌های خلاق و تیم‌های فنی. ترکیب مدیریت وظایف، همکاری مشتری، و اتوماسیون workflow در یک پلتفرم شهودی.","challenge":"تیم‌های دورکار در tool fragmentation غرق بودند—Slack برای ارتباطات، Trello برای وظایف، Drive برای فایل‌ها. Context switching بهره‌وری را نابود می‌کرد، مشتریان احساس exclusion می‌کردند.","solution":"Workspace همه‌در-یکی با بردهای Kanban پیشرفته، ردیابی زمان integrated، پورتال‌های مشتری white-label برای شفافیت کامل، و workflow automation با triggerهای سفارشی.","results":["جذب ۲۰۰+ شرکت paying customer در ۱۲ ماه","بهبود ۲۵٪ زمان تحویل پروژه (on-time delivery)","افزایش ۴۵٪ امتیاز رضایت مشتری (CSAT)","کاهش ۵۰٪ زمان جلسات status weekly"],"technologies":["SvelteKit","Node.js","GraphQL","Docker","AWS ECS"],"category":"نرم‌افزار به‌عنوان سرویس (SaaS)"}],"ctaText":"پروژه‌ای در ذهن دارید؟ بیایید درباره معماری فنی و استراتژی اجرای آن گفتگو کنیم.","ctaLabel":"درخواست جلسه مشاوره"}},"now":"$undefined","timeZone":"Asia/Tehran","children":"$L17"}]
