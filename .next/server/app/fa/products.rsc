f:["$","$L15",null,{"formats":"$undefined","locale":"fa","messages":{"meta":{"siteName":"بیگ‌بلک‌باکس","titleSuffix":"بیگ‌بلک‌باکس — آزمایشگاه مهندسی سیستم","description":"بیگ‌بلک‌باکس یک استودیوی دو نفره برای طراحی و ساخت سیستم‌های دیجیتال است."},"nav":{"home":"خانه","products":"خدمات","portfolio":"نمونه‌کارها","about":"درباره ما","contact":"تماس","menu":"منو","close":"بستن"},"langSwitch":{"fa":"فا","en":"EN"},"footerLabel":"آزمایشگاه مهندسی سیستم — بیگ‌بلک‌باکس","social":{"instagram":"اینستاگرام","linkedin":"لینکدین","github":"گیت‌هاب","telegram":"تلگرام"},"home":{"eyebrow":"بیگ‌بلک‌باکس / آزمایشگاه مهندسی سیستم","kicker":"۰۱ / خانه","headlineLine1":"ما سایت طراحی","headlineLine2":"نمی‌کنیم.","headlineLine3":"سیستم می‌سازیم.","lead":"دو نفر هستیم؛ با ذهنیت یک تیم فنی کامل. از رابطی که می‌بینید تا موتوری که آرام و دقیق پشت آن کار می‌کند.","blocks":[{"label":"تیم","value":"۲ مهندس، یک ذهن"},{"label":"رویکرد","value":"سیستم، نه فقط صفحه"},{"label":"خروجی","value":"وب‌سایت، وب‌اپ و اتوماسیون"},{"label":"همکاری","value":"شفاف، نزدیک و همیشه در دسترس"}],"statement":"هر پروژه برای ما یک جعبه‌سیاه مهندسی‌شده است؛ بیرونش ساده و روشن، درونش دقیق و بی‌نقص.","ctaLabel":"سیستم شما را بسازیم","ctaHint":"شروع یک پروژه"},"products":{"eyebrow":"بیگ‌بلک‌باکس / کاتالوگ خدمات","kicker":"۰۲ / خدمات","headline":"چه چیزی می‌سازیم","lead":"هر خدمت یک ماژول از یک سیستم کامل است؛ یکی را انتخاب کنید یا همه را به هم متصل کنید.","items":[{"index":"۰۰۱","title":"وب‌سایت و وب‌اپ","description":"طراحی و توسعه‌ی سریع، متمایز و دقیق برای تجربه‌ای که درست کار می‌کند."},{"index":"۰۰۲","title":"سیستم‌های داخلی کسب‌وکار","description":"پنل‌های مدیریتی و گردش‌کارهای سفارشی برای ساده‌تر شدن کار روزانه‌ی تیم."},{"index":"۰۰۳","title":"اتوماسیون و یکپارچه‌سازی","description":"اتصال سرویس‌ها، ابزارها و داده‌ها؛ کاری که دستی بود حالا خودکار انجام می‌شود."},{"index":"۰۰۴","title":"طراحی محصول و SaaS","description":"از ایده تا نسخه‌ی قابل عرضه؛ معماری محصول، رابط کاربری و تجربه‌ای که دوستش دارند."},{"index":"۰۰۵","title":"داشبورد و تحلیل داده","description":"تبدیل داده‌های پراکنده به تصمیم‌های روشن؛ داشبوردهایی که واقعاً خوانده می‌شوند."}],"ctaLabel":"پروژه‌تان را مطرح کنید","ctaHint":"درخواست مشاوره"},"about":{"eyebrow":"بیگ‌بلک‌باکس / تیم","kicker":"۰۳ / درباره ما","headline":"دو نفر، یک سیستم فکری","lead":"بیگ‌بلک‌باکس را دو نفر ساخته‌اند که طراحی رابط و معماری پشت‌صحنه را یک جریان واحد می‌بینند. محصول خوب از فکر منسجم می‌آید، نه کارهای پراکنده.","blocks":[{"label":"بنیان‌گذاری","value":"تیم مستقل دو نفره"},{"label":"فلسفه","value":"سیستم، قبل از صفحه"},{"label":"دامنه کار","value":"از طراحی تا استقرار"},{"label":"همکاری","value":"شفاف و مرحله‌به‌مرحله"}],"processTitle":"روش کار ما","process":[{"step":"۰۱","title":"فهم مسئله","description":"قبل از هر خط طراحی یا کد، می‌فهمیم مسئله‌ی واقعی کجاست."},{"step":"۰۲","title":"طراحی سیستم","description":"معماری کامل، جریان داده و تجربه‌ی کاربر را کنار هم می‌چینیم."},{"step":"۰۳","title":"ساخت و آزمون","description":"مرحله‌به‌مرحله می‌سازیم، نشان می‌دهیم و با بازخورد شما اصلاح می‌کنیم."},{"step":"۰۴","title":"تحویل و همراهی","description":"سیستم را تحویل می‌دهیم و برای رشد بعدی کنار شما می‌مانیم."}],"statement":"اسمش را بیگ‌بلک‌باکس گذاشتیم چون کار ما پیچیدگی را داخل جعبه نگه می‌دارد و فقط سادگی را به شما تحویل می‌دهد.","ctaLabel":"با ما آشنا شوید","ctaHint":"شروع گفتگو"},"contact":{"title":"بیایید بسازیمش","subtitle":"چند خط درباره‌ی پروژه‌تان بنویسید؛ حداکثر تا یک روز کاری پاسخ می‌دهیم.","nameLabel":"نام","namePlaceholder":"نام شما","emailLabel":"ایمیل","emailPlaceholder":"you@example.com","messageLabel":"پیام","messagePlaceholder":"درباره‌ی پروژه‌تان بگویید...","submit":"ارسال پیام","sending":"در حال ارسال...","success":"پیام شما دریافت شد؛ به‌زودی پاسخ می‌دهیم.","error":"مشکلی پیش آمد. دوباره تلاش کنید یا مستقیم ایمیل بزنید.","close":"بستن"},"portfolio":{"eyebrow":"بیگ‌بلک‌باکس / نمونه‌کارهای منتخب","kicker":"۰۴ / نمونه‌کارها","headline":"پروژه‌هایی که ساختیم","lead":"گزیده‌ای از سیستم‌ها، محصولات و تجربه‌های دیجیتالی که از صفر مهندسی کردیم. هر کدام یک جعبه‌سیاه: پیچیده درون، ساده بیرون.","items":[{"id":"ecommerce-platform","index":"۰۰۱","title":"پلتفرم فروشگاهی آنلاین","shortDescription":"راهکار کامل فروشگاهی با مدیریت موجودی سفارشی و پردازش خودکار سفارش.","fullDescription":"ما یک اکوسیستم فروشگاهی با کارایی بالا طراحی کردیم که برای رشد سریع ساخته شده است. با تمرکز بر اتوماسیون و تجربه کاربری، یک فروشگاه آنلاین معمولی را به ماشینی برای تولید درآمد تبدیل کردیم که ۲۴/۷ بدون دخالت دستی کار می‌کند.","challenge":"مشتری با بروزرسانی دستی موجودی، فرآیند پرداخت کند که باعث رها شدن ۶۰٪ سبدهای خرید می‌شد، و سیستم قدیمی که در زمان ترافیک بالا از کار می‌افتاد دست و پنجه نرم می‌کرد. هر روز فروش از دست می‌رفت.","solution":"ما یک معماری headless commerce با Next.js برای سرعت بارگذاری فوق‌العاده ساختیم، همگام‌سازی خودکار موجودی بین انبارها را یکپارچه کردیم، و فرآیند پرداخت را به فقط ۳ مرحله کاهش دادیم. تحلیل بلادرنگ دید لحظه‌ای به عملکرد فروش داد.","results":["کاهش ۶۰٪ رها کردن سبد خرید","سرعت بارگذاری صفحات ۳ برابر سریع‌تر","افزایش ۴۰٪ نرخ تبدیل در ۳ ماه","بدون قطعی در ترافیک بلک فرایدی"],"technologies":["Next.js","Node.js","PostgreSQL","Stripe","Redis"],"category":"وب‌اپلیکیشن"},{"id":"healthcare-dashboard","index":"۰۰۲","title":"سیستم مدیریت مراکز درمانی","shortDescription":"پلتفرم مدیریت بیماران که کلینیک‌ها، پزشکان و داروخانه‌ها را به هم متصل می‌کند.","fullDescription":"یک اکوسیستم مراقبت بهداشتی مطابق با HIPAA که مراقبت از بیمار را از نوبت‌دهی تا تحویل نسخه ساده می‌کند. ما پل امنی بین متخصصان پزشکی، بیماران و داروخانه‌ها ساختیم.","challenge":"کادر پزشکی بیش از ۲۰ ساعت در هفته را صرف ورود دستی داده‌ها در سیستم‌های جداگانه می‌کردند. پرونده بیماران پراکنده بود، عدم حضور در نوبت‌ها بالا بود، و امنیت داده نگرانی دائمی بود.","solution":"ما یک داشبورد یکپارچه با یادآورهای خودکار نوبت، پرونده الکترونیک سلامت با دسترسی مبتنی بر نقش، و ویژگی‌های نسخه الکترونیکی یکپارچه توسعه دادیم. رمزنگاری end-to-end انطباق کامل HIPAA را تضمین کرد.","results":["ذخیره ۲۰ ساعت در هفته برای هر کلینیک","هیچ نقض داده‌ای از زمان راه‌اندازی","کاهش ۳۵٪ عدم حضور در نوبت‌ها","نرخ رضایت ۹۵٪ среди کادر پزشکی"],"technologies":["React","TypeScript","AWS","MongoDB","Socket.io"],"category":"سیستم کسب‌وکار"},{"id":"fintech-analytics","index":"۰۰۳","title":"داشبورد تحلیل مالی","shortDescription":"تصویرسازی بلادرنگ داده‌های مالی برای شرکت‌های سرمایه‌گذاری.","fullDescription":"یک پلتفرم هوش مالی پیشرفته که داده‌های پیچیده بازار را به بینش‌های عملی تبدیل می‌کند. ما یک مرکز فرماندهی برای تصمیمات سرمایه‌گذاری با بروزرسانی داده در سطح میلی‌ثانیه ایجاد کردیم.","challenge":"تحلیلگران سرمایه‌گذاری برای داشتن دید کامل بازار با ۵+ ابزار مختلف دست و پنجه نرم می‌کردند. تاخیر داده باعث فرصت‌های از دست رفته می‌شد، و گزارش‌گیری سفارشی ساعت‌ها زمان می‌برد.","solution":"ما چندین API مالی را در یک داشبورد بلادرنگ واحد با ویجت‌های قابل تنظیم، تولید خودکار گزارش، و تحلیل پیش‌بینانه مبتنی بر الگوریتم‌های یادگیری ماشین تجمیع کردیم.","results":["داده بلادرنگ از ۱۲+ بورس جهانی","کاهش ۸۰٪ زمان تولید گزارش","شناسایی بیش از ۲ میلیون دلار فرصت سرمایه‌گذاری از دست رفته قبلی","استفاده توسط ۳ شرکت بزرگ سرمایه‌گذاری"],"technologies":["Vue.js","Python","D3.js","GraphQL","TimescaleDB"],"category":"داشبورد و تحلیل"},{"id":"restaurant-app","index":"۰۰۴","title":"اپلیکیشن سفارش رستوران","shortDescription":"سیستم سفارش‌گیری موبایل‌محور با یکپارچه‌سازی نمایشگاه آشپزخانه.","fullDescription":"یک تجربه غذای بدون تماس که کارایی سفارش را ۴۰٪ افزایش داد. مشتریان با اسکن QR کد، منوی تعاملی را مرور می‌کنند، سفارش می‌دهند و پرداخت می‌کنند—همه از گوشی خود. کارکنان آشپزخانه سفارشات را بلافاصله روی نمایشگرهای دیجیتال دریافت می‌کنند.","challenge":"زنجیره رستوران با کمبود شدید نیرو، زمان انتظار طولانی که منجر به شکایت مشتریان می‌شد، و دقت ناسازگار سفارش مواجه بود. چرخش میز برای حداکثر کردن درآمد خیلی کند بود.","solution":"ما یک Progressive Web App قابل دسترسی via QR کدها مستقر کردیم، مستقیماً با سیستم‌های نمایش آشپزخانه و POS یکپارچه شدیم. الگوریتم‌های هوشمند upselling ارزش متوسط سفارش را افزایش داد، در حالی که مسیریابی خودکار سفارش خطاهای آشپزخانه را کاهش داد.","results":["افزایش ۴۰٪ کارایی سفارش","چرخش ۲۵٪ سریع‌تر میز","افزایش ۱۵٪ ارزش متوسط سفارش از طریق upselling هوشمند","کاهش ۹۰٪ خطاهای سفارش"],"technologies":["React","PWA","Firebase","Stripe","WebSocket"],"category":"وب‌اپ و موبایل"},{"id":"logistics-automation","index":"۰۰۵","title":"پلتفرم اتوماسیون لجستیک","shortDescription":"مدیریت لجستیک端到端 با بهینه‌سازی مسیر.","fullDescription":"یک مرکز فرماندهی لجستیک هوشمند که مسیرهای تحویل را بلادرنگ بهینه می‌کند، حرکات ناوگان را در سطح جهانی ردیابی می‌کند، و تصمیمات اعزام را خودکار می‌کند. ما هرج و مرج را به دقت هماهنگ تبدیل کردیم.","challenge":"شرکت لجستیک دید صفر به ناوگان خود داشت، برنامه‌ریزی دستی مسیر ناکارآمد بود، و مشتریان از زمان‌های تحویل غیرقابل پیش‌بینی شکایت می‌کردند. هزینه‌های عملیاتی در حال افزایش بود.","solution":"ما یک سیستم ردیابی GPS-enabled با بهینه‌سازی مسیر مبتنی بر هوش مصنوعی ساختیم، اعزام خودکار بر اساس دسترسی راننده و شرایط ترافیک، و پورتال‌های ردیابی مشتری‌محور با ETAهای دقیق.","results":["کاهش ۲۵٪ هزینه‌های عملیاتی","۳۰٪ تحویل دیرتر کمتر","ردیابی بلادرنگ برای ۱۰۰٪ محموله‌ها","کاهش ۴۰٪ تیکت‌های پشتیبانی مشتری"],"technologies":["Angular","Go","Google Maps API","Kafka","PostgreSQL"],"category":"اتوماسیون و یکپارچه‌سازی"},{"id":"saas-project-tool","index":"۰۰۶","title":"ابزار مدیریت پروژه SaaS","shortDescription":"پلتفرم مشارکتی با اتوماسیون وظایف و پورتال مشتریان.","fullDescription":"یک راهکار مدیریت پروژه مدرن ساخته‌شده برای آژانس‌های خلاق و تیم‌های فنی. ما مدیریت وظایف، همکاری مشتری، و گردش‌کارهای خودکار را در یک پلتفرم شهودی ترکیب کردیم.","challenge":"تیم‌های دورکار در تکه‌تکه بودن ابزار غرق شده بودند—Slack برای چت، Trello برای وظایف، Google Drive برای فایل‌ها. تغییر زمینه بهره‌وری را می‌کشت، و مشتریان احساس می‌کردند خارج از حلقه هستند.","solution":"ما یک فضای کار همه‌در-یکی با بردهای Kanban، ردیابی زمان، پورتال‌های مشتری برای مشاهده شفاف پیشرفت، و اتوماسیون گردش کاری که وظایف تکراری را خودکار مدیریت می‌کند ارائه دادیم.","results":["استفاده توسط ۲۰۰+ شرکت در سطح جهانی","بهبود ۲۵٪ در زمان تحویل پروژه","افزایش ۴۵٪ امتیازات رضایت مشتری","کاهش ۵۰٪ زمان جلسات وضعیت"],"technologies":["Svelte","Node.js","GraphQL","Docker","AWS"],"category":"محصول SaaS"}],"ctaText":"پروژه‌ای در ذهن دارید؟ بیایید درباره‌ی ساخت سیستمی متناسب با نیازهایتان گفتگو کنیم.","ctaLabel":"شروع گفتگو"}},"now":"$undefined","timeZone":"UTC","children":"$L16"}]
