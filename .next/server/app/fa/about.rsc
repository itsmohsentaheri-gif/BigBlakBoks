f:["$","$L15",null,{"formats":"$undefined","locale":"fa","messages":{"meta":{"siteName":"بیگ‌بلک‌باکس","titleSuffix":"بیگ‌بلک‌باکس — آزمایشگاه مهندسی سیستم","description":"بیگ‌بلک‌باکس یک استودیوی دو نفره برای طراحی و ساخت سیستم‌های دیجیتال است."},"nav":{"home":"خانه","products":"خدمات","portfolio":"نمونه‌کارها","about":"درباره ما","contact":"تماس","menu":"منو","close":"بستن"},"langSwitch":{"fa":"فا","en":"EN"},"footerLabel":"آزمایشگاه مهندسی سیستم — بیگ‌بلک‌باکس","social":{"instagram":"اینستاگرام","linkedin":"لینکدین","github":"گیت‌هاب","telegram":"تلگرام"},"home":{"eyebrow":"بیگ‌بلک‌باکس / آزمایشگاه مهندسی سیستم","kicker":"۰۱ / خانه","headlineLine1":"ما سایت طراحی","headlineLine2":"نمی‌کنیم.","headlineLine3":"سیستم می‌سازیم.","lead":"دو نفر هستیم؛ با ذهنیت یک تیم فنی کامل. از رابطی که می‌بینید تا موتوری که آرام و دقیق پشت آن کار می‌کند.","blocks":[{"label":"تیم","value":"۲ مهندس، یک ذهن"},{"label":"رویکرد","value":"سیستم، نه فقط صفحه"},{"label":"خروجی","value":"وب‌سایت، وب‌اپ و اتوماسیون"},{"label":"همکاری","value":"شفاف، نزدیک و همیشه در دسترس"}],"statement":"هر پروژه برای ما یک جعبه‌سیاه مهندسی‌شده است؛ بیرونش ساده و روشن، درونش دقیق و بی‌نقص.","ctaLabel":"سیستم شما را بسازیم","ctaHint":"شروع یک پروژه"},"products":{"eyebrow":"بیگ‌بلک‌باکس / کاتالوگ خدمات","kicker":"۰۲ / خدمات","headline":"چه چیزی می‌سازیم","lead":"هر خدمت یک ماژول از یک سیستم کامل است؛ یکی را انتخاب کنید یا همه را به هم متصل کنید.","items":[{"index":"۰۰۱","title":"وب‌سایت و وب‌اپ","description":"طراحی و توسعه‌ی سریع، متمایز و دقیق برای تجربه‌ای که درست کار می‌کند."},{"index":"۰۰۲","title":"سیستم‌های داخلی کسب‌وکار","description":"پنل‌های مدیریتی و گردش‌کارهای سفارشی برای ساده‌تر شدن کار روزانه‌ی تیم."},{"index":"۰۰۳","title":"اتوماسیون و یکپارچه‌سازی","description":"اتصال سرویس‌ها، ابزارها و داده‌ها؛ کاری که دستی بود حالا خودکار انجام می‌شود."},{"index":"۰۰۴","title":"طراحی محصول و SaaS","description":"از ایده تا نسخه‌ی قابل عرضه؛ معماری محصول، رابط کاربری و تجربه‌ای که دوستش دارند."},{"index":"۰۰۵","title":"داشبورد و تحلیل داده","description":"تبدیل داده‌های پراکنده به تصمیم‌های روشن؛ داشبوردهایی که واقعاً خوانده می‌شوند."}],"ctaLabel":"پروژه‌تان را مطرح کنید","ctaHint":"درخواست مشاوره"},"about":{"eyebrow":"بیگ‌بلک‌باکس / تیم","kicker":"۰۳ / درباره ما","headline":"دو نفر، یک سیستم فکری","lead":"بیگ‌بلک‌باکس را دو نفر ساخته‌اند که طراحی رابط و معماری پشت‌صحنه را یک جریان واحد می‌بینند. محصول خوب از فکر منسجم می‌آید، نه کارهای پراکنده.","blocks":[{"label":"بنیان‌گذاری","value":"تیم مستقل دو نفره"},{"label":"فلسفه","value":"سیستم، قبل از صفحه"},{"label":"دامنه کار","value":"از طراحی تا استقرار"},{"label":"همکاری","value":"شفاف و مرحله‌به‌مرحله"}],"processTitle":"روش کار ما","process":[{"step":"۰۱","title":"فهم مسئله","description":"قبل از هر خط طراحی یا کد، می‌فهمیم مسئله‌ی واقعی کجاست."},{"step":"۰۲","title":"طراحی سیستم","description":"معماری کامل، جریان داده و تجربه‌ی کاربر را کنار هم می‌چینیم."},{"step":"۰۳","title":"ساخت و آزمون","description":"مرحله‌به‌مرحله می‌سازیم، نشان می‌دهیم و با بازخورد شما اصلاح می‌کنیم."},{"step":"۰۴","title":"تحویل و همراهی","description":"سیستم را تحویل می‌دهیم و برای رشد بعدی کنار شما می‌مانیم."}],"statement":"اسمش را بیگ‌بلک‌باکس گذاشتیم چون کار ما پیچیدگی را داخل جعبه نگه می‌دارد و فقط سادگی را به شما تحویل می‌دهد.","ctaLabel":"با ما آشنا شوید","ctaHint":"شروع گفتگو"},"contact":{"title":"بیایید بسازیمش","subtitle":"چند خط درباره‌ی پروژه‌تان بنویسید؛ حداکثر تا یک روز کاری پاسخ می‌دهیم.","nameLabel":"نام","namePlaceholder":"نام شما","emailLabel":"ایمیل","emailPlaceholder":"you@example.com","messageLabel":"پیام","messagePlaceholder":"درباره‌ی پروژه‌تان بگویید...","submit":"ارسال پیام","sending":"در حال ارسال...","success":"پیام شما دریافت شد؛ به‌زودی پاسخ می‌دهیم.","error":"مشکلی پیش آمد. دوباره تلاش کنید یا مستقیم ایمیل بزنید.","close":"بستن"},"portfolio":{"eyebrow":"بیگ‌بلک‌باکس / نمونه‌کارهای منتخب","kicker":"۰۴ / نمونه‌کارها","headline":"پروژه‌هایی که ساختیم","lead":"گزیده‌ای از سیستم‌ها، محصولات و تجربه‌های دیجیتالی که از صفر مهندسی کردیم. هر کدام یک جعبه‌سیاه: پیچیده درون، ساده بیرون.","items":[{"index":"۰۰۱","title":"پلتفرم فروشگاهی آنلاین","description":"راهکار کامل فروشگاهی با مدیریت موجودی سفارشی، پردازش خودکار سفارش و داشبورد تحلیل بلادرنگ. ساخته‌شده برای مقیاس‌پذیری و سرعت.","category":"وب‌اپلیکیشن"},{"index":"۰۰۲","title":"سیستم مدیریت مراکز درمانی","description":"پلتفرم مدیریت بیماران که کلینیک‌ها، پزشکان و داروخانه‌ها را به هم متصل می‌کند. شامل نوبت‌دهی، پرونده الکترونیک سلامت و رهگیری نسخه.","category":"سیستم کسب‌وکار"},{"index":"۰۰۳","title":"داشبورد تحلیل مالی","description":"ابزار تصویرسازی داده‌های مالی بلادرنگ برای شرکت‌های سرمایه‌گذاری. تجمیع چندین منبع داده به بینش‌های عملی با گزارش‌های سفارشی.","category":"داشبورد و تحلیل"},{"index":"۰۰۴","title":"اپلیکیشن سفارش رستوران","description":"سیستم سفارش‌گیری موبایل‌محور با یکپارچه‌سازی نمایشگاه آشپزخانه، رهگیری موجودی و برنامه وفاداری مشتریان. افزایش ۴۰٪ کارایی سفارش.","category":"وب‌اپ و موبایل"},{"index":"۰۰۵","title":"پلتفرم اتوماسیون لجستیک","description":"سیستم مدیریت لجستیک端到端 با بهینه‌سازی مسیر، رهگیری ناوگان و اعزام خودکار. کاهش ۲۵٪ هزینه‌های عملیاتی.","category":"اتوماسیون و یکپارچه‌سازی"},{"index":"۰۰۶","title":"ابزار مدیریت پروژه SaaS","description":"پلتفرم مدیریت پروژه مشارکتی با اتوماسیون وظایف، گردش‌کار تیمی و پورتال مشتریان. طراحی‌شده برای آژانس‌های خلاق و تیم‌های فنی.","category":"محصول SaaS"}],"ctaText":"پروژه‌ای در ذهن دارید؟ بیایید درباره‌ی ساخت سیستمی متناسب با نیازهایتان گفتگو کنیم.","ctaLabel":"شروع گفتگو"}},"now":"$undefined","timeZone":"UTC","children":"$L16"}]
